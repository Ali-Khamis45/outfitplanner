[
  {
    "type": "function",
    "function": {
      "name": "get_wardrobe",
      "description": "Return compact wardrobe items matching all filters; seasons and occasions match any within each list.",
      "parameters": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "top",
                  "bottom",
                  "outerwear",
                  "shoes",
                  "accessory"
                ]
              },
              "seasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "spring",
                    "summer",
                    "autumn",
                    "winter"
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              },
              "occasions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 20
              },
              "formality_min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "formality_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "warmth_min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "warmth_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "colour": {
                "type": "string",
                "description": "Exact colour name or hex, case insensitive."
              },
              "not_worn_days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 36500,
                "description": "Exclude items worn in the last N days; never-worn items match."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_weather",
      "description": "Get daily forecast from Open-Meteo; dates are limited to its forecast availability.",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Forecast date YYYY-MM-DD."
          },
          "city": {
            "type": "string",
            "description": "City name; defaults to Cairo."
          }
        },
        "required": [
          "date"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_fit",
      "description": "Find the selected size fit summary and recommended size or unknown.",
      "parameters": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "description": "Wardrobe item ID."
          },
          "body": {
            "type": "string",
            "enum": [
              "neutral",
              "personal-scaled"
            ]
          }
        },
        "required": [
          "item_id",
          "body"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "show_on_avatar",
      "description": "Create a fitting-room URL for one supported top and one supported bottom.",
      "parameters": {
        "type": "object",
        "properties": {
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "description": "Exactly one top ID and one bottom ID."
          },
          "pose": {
            "type": "string",
            "enum": [
              "rest",
              "walk",
              "both-90"
            ]
          }
        },
        "required": [
          "item_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "log_worn",
      "description": "Record a wear event. Each selected item is counted once per call, including outfit members.",
      "parameters": {
        "type": "object",
        "properties": {
          "outfit_or_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "Item or saved outfit IDs."
          },
          "date": {
            "type": "string",
            "description": "Wear date YYYY-MM-DD."
          }
        },
        "required": [
          "outfit_or_item_ids",
          "date"
        ],
        "additionalProperties": false
      }
    }
  }
]
